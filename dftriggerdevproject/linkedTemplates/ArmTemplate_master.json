{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "dftriggerdevproject"
		},
		"LS_CSV_FILE_STORAGE_ADLS_INPUT_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_CSV_FILE_STORAGE_ADLS_INPUT'"
		},
		"LS_CSV_FILE_TO_PARUET_OUPUT_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_CSV_FILE_TO_PARUET_OUPUT'"
		},
		"LS_EVENT_CSV_FILE_MOVE_PARQUET_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_EVENT_CSV_FILE_MOVE_PARQUET'"
		},
		"LS_EVENT_CSV_FILE_STORAGE_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_EVENT_CSV_FILE_STORAGE'"
		},
		"LS_CSV_FILE_STORAGE_ADLS_INPUT_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsdevcsvtriggerinput.dfs.core.windows.net/"
		},
		"LS_CSV_FILE_TO_PARUET_OUPUT_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsdevcsvtriggeroutput.dfs.core.windows.net/"
		},
		"LS_EVENT_CSV_FILE_MOVE_PARQUET_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsdevcsvtriggeroutput.dfs.core.windows.net/"
		},
		"LS_EVENT_CSV_FILE_STORAGE_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsdevcsvtriggerinput.dfs.core.windows.net/"
		},
		"EVENT_MANNUAL_FILE_MOVE_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/c1fa00d8-7ab6-47e1-9161-266d98deded3/resourceGroups/rstriggerproject/providers/Microsoft.Storage/storageAccounts/adlsdevcsvtriggerinput"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "dftriggerdevproject_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_CSV_FILE_STORAGE_ADLS_INPUT_accountKey": {
						"value": "[parameters('LS_CSV_FILE_STORAGE_ADLS_INPUT_accountKey')]"
					},
					"LS_CSV_FILE_TO_PARUET_OUPUT_accountKey": {
						"value": "[parameters('LS_CSV_FILE_TO_PARUET_OUPUT_accountKey')]"
					},
					"LS_EVENT_CSV_FILE_MOVE_PARQUET_accountKey": {
						"value": "[parameters('LS_EVENT_CSV_FILE_MOVE_PARQUET_accountKey')]"
					},
					"LS_EVENT_CSV_FILE_STORAGE_accountKey": {
						"value": "[parameters('LS_EVENT_CSV_FILE_STORAGE_accountKey')]"
					},
					"LS_CSV_FILE_STORAGE_ADLS_INPUT_properties_typeProperties_url": {
						"value": "[parameters('LS_CSV_FILE_STORAGE_ADLS_INPUT_properties_typeProperties_url')]"
					},
					"LS_CSV_FILE_TO_PARUET_OUPUT_properties_typeProperties_url": {
						"value": "[parameters('LS_CSV_FILE_TO_PARUET_OUPUT_properties_typeProperties_url')]"
					},
					"LS_EVENT_CSV_FILE_MOVE_PARQUET_properties_typeProperties_url": {
						"value": "[parameters('LS_EVENT_CSV_FILE_MOVE_PARQUET_properties_typeProperties_url')]"
					},
					"LS_EVENT_CSV_FILE_STORAGE_properties_typeProperties_url": {
						"value": "[parameters('LS_EVENT_CSV_FILE_STORAGE_properties_typeProperties_url')]"
					},
					"EVENT_MANNUAL_FILE_MOVE_properties_typeProperties_scope": {
						"value": "[parameters('EVENT_MANNUAL_FILE_MOVE_properties_typeProperties_scope')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}